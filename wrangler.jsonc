{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quickshot",
  "main": "./src/worker.ts",
  "account_id": "e9bc21da719562a3e45d77de7dd042de",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Quick Actions require remote mode for local development (wrangler dev
   // --remote). Deployed Workers run in real Cloudflare so remote=true is not
   // needed in production. Add it locally if testing the MCP through wrangler
   // dev, or use CLOUDFLARE_ACCOUNT_ID env var.
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "quickshot-screenshots"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://quickshot.examples.workers.dev",
    // Public r2.dev URL for the quickshot-screenshots bucket.
    "SCREENSHOTS_PUBLIC_BASE": "https://pub-00765cd1170f425da672c853a6270dbb.r2.dev"
  },
  "observability": {
    "enabled": true
  }
}
